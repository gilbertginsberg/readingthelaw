---
const navLinks = [
  { href: "/what-is-reading-the-law/", label: "What Is It" },
  { href: "/states/", label: "State Guides" },
  { href: "/faq/", label: "FAQ" },
  { href: "/resources/", label: "Resources" },
  { href: "/about/", label: "About" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-navy/10 bg-parchment/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-center gap-2 font-serif text-lg font-bold text-navy">
      <span class="flex h-8 w-8 items-center justify-center rounded-sm bg-navy text-brass-light">§</span>
      Reading the Law
    </a>
    <button
      id="nav-toggle"
      class="flex h-9 w-9 items-center justify-center rounded border border-navy/20 text-navy md:hidden"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <ul id="nav-links" class="hidden items-center gap-7 text-sm font-medium text-ink-light md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:text-brass",
                currentPath === link.href || currentPath.startsWith(link.href) ? "text-navy font-semibold" : "",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/matchmaking/"
          class="rounded-sm bg-navy px-4 py-2 text-parchment transition-colors hover:bg-navy-light"
        >
          Find a Mentor →
        </a>
      </li>
    </ul>
  </nav>
  <ul id="nav-links-mobile" class="hidden flex-col gap-1 border-t border-navy/10 bg-parchment px-5 py-3 text-sm font-medium text-ink-light md:hidden">
    {
      navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-2">
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/matchmaking/" class="mt-1 block rounded-sm bg-navy px-4 py-2 text-center text-parchment">
        Find a Mentor →
      </a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("nav-links-mobile");
  toggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("flex");
    mobileMenu?.classList.toggle("flex", !isOpen);
    mobileMenu?.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
