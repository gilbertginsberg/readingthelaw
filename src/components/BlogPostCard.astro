---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={`/blog/${post.id}/`}
  class="group block rounded-lg border border-navy/10 bg-white p-6 transition hover:border-brass hover:shadow-md"
>
  <p class="text-xs uppercase tracking-wide text-ink-light">{formattedDate}</p>
  <h3 class="mt-1 font-serif text-xl font-bold text-navy group-hover:text-brass">{post.data.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-light">{post.data.description}</p>
  <span class="mt-4 inline-block text-sm font-semibold text-brass group-hover:text-navy">Read more →</span>
</a>
