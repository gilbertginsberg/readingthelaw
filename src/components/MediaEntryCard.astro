---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"media">;
  index: number;
}

const { entry, index } = Astro.props;
const formattedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const domain = new URL(entry.data.url).hostname.replace(/^www\./, "");
---

<li class="flex gap-3">
  <span class="mt-0.5 text-sm font-semibold text-ink-light tabular-nums">{index}.</span>
  <div>
    <p class="leading-snug">
      <a
        href={entry.data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-serif font-semibold text-navy hover:text-brass"
      >
        {entry.data.title}
      </a>
      <span class="text-sm text-ink-light"> ({domain})</span>
    </p>
    <p class="mt-1 text-sm leading-relaxed text-ink-light">{entry.data.note}</p>
    <p class="mt-1 text-xs uppercase tracking-wide text-ink-light/60">{entry.data.publication} · {formattedDate}</p>
  </div>
</li>
