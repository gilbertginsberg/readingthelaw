---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"media">;
}

const { entry } = Astro.props;
const formattedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="rounded-lg border border-navy/10 bg-white p-6">
  <a
    href={entry.data.url}
    target="_blank"
    rel="noopener noreferrer"
    class="font-serif text-lg font-bold text-navy hover:text-brass"
  >
    {entry.data.title}
  </a>
  <p class="mt-1 text-xs uppercase tracking-wide text-ink-light">{entry.data.publication} · {formattedDate}</p>
  <p class="mt-3 text-sm leading-relaxed text-ink-light">{entry.data.note}</p>
</div>
