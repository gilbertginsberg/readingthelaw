---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="This page doesn't exist." noindex={true}>
  <div class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-5 py-24 text-center">
    <p class="font-serif text-6xl font-bold text-navy">404</p>
    <h1 class="mt-4 font-serif text-2xl font-bold text-navy">Page not found</h1>
    <p class="mt-3 text-ink-light">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a href="/" class="mt-8 rounded-sm bg-navy px-6 py-3 font-semibold text-parchment hover:bg-navy-light">
      Back to Home
    </a>
  </div>
</BaseLayout>
