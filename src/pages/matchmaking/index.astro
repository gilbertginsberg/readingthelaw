---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<BaseLayout
  title="Mentor Matchmaking — Coming Soon"
  description="A future platform connecting aspiring law readers with attorneys and judges open to sponsoring an apprenticeship. Join the waitlist as an apprentice or a sponsoring attorney."
>
  <PageHeader
    eyebrow="Coming Soon"
    title="Connecting apprentices with sponsoring attorneys"
    subtitle="Finding a mentor willing to commit years of supervision is the biggest barrier to reading the law. We're building a platform to fix that."
  />

  <div class="mx-auto max-w-3xl px-5 py-16">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-navy/10 bg-white p-6">
        <h2 class="font-serif text-lg font-bold text-navy">For aspiring apprentices</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-light">
          Search for attorneys and judges by state, practice area, and availability instead of cold-emailing
          your way through a network you don't have yet. Build a profile that shows you're serious.
        </p>
      </div>
      <div class="rounded-lg border border-navy/10 bg-white p-6">
        <h2 class="font-serif text-lg font-bold text-navy">For sponsoring attorneys</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-light">
          Review candidates who already understand your state's requirements and the commitment involved,
          instead of starting from scratch every time someone asks you to consider mentoring them.
        </p>
      </div>
    </div>

    <div class="prose-legal mt-12">
      <h2>What we're planning to build</h2>
      <ul>
        <li><strong>Searchable profiles</strong> for apprentices and sponsoring attorneys, filterable by state program, practice area, and time availability.</li>
        <li><strong>Structured onboarding</strong> that walks both sides through their specific state's requirements before they ever have a conversation, so nobody starts from zero.</li>
        <li><strong>Progress tracking tools</strong> to help apprentices and supervisors log required study hours and milestones together.</li>
        <li><strong>A vetting layer</strong> so apprentices can verify a prospective supervisor's bar status and experience, and attorneys can see a candidate's seriousness and prior preparation.</li>
      </ul>
      <p>
        None of this exists yet — this page is a placeholder for a real platform we're actively building.
        The fastest way to shape what we build is to tell us what you need below.
      </p>
    </div>

    <div id="waitlist" class="mt-12 rounded-xl border border-navy/10 bg-navy p-8 sm:p-10">
      <h2 class="font-serif text-xl font-bold text-parchment">Join the waitlist</h2>
      <p class="mt-2 text-sm text-parchment/70">
        Tell us who you are and we'll reach out when the platform is ready. This opens your email client —
        we don't collect or store anything on this page.
      </p>
      <form id="waitlist-form" class="mt-6 space-y-4">
        <div>
          <span class="mb-2 block text-sm font-semibold text-parchment/90">I am a...</span>
          <div class="flex flex-col gap-2 sm:flex-row">
            <label class="flex flex-1 cursor-pointer items-center gap-2 rounded-md border border-parchment/20 bg-parchment/5 px-4 py-3 text-sm text-parchment has-[:checked]:border-brass has-[:checked]:bg-brass/10">
              <input type="radio" name="role" value="Aspiring apprentice" checked class="accent-brass" />
              Aspiring apprentice
            </label>
            <label class="flex flex-1 cursor-pointer items-center gap-2 rounded-md border border-parchment/20 bg-parchment/5 px-4 py-3 text-sm text-parchment has-[:checked]:border-brass has-[:checked]:bg-brass/10">
              <input type="radio" name="role" value="Attorney open to sponsoring" class="accent-brass" />
              Attorney open to sponsoring
            </label>
          </div>
        </div>
        <div>
          <label for="waitlist-name" class="mb-2 block text-sm font-semibold text-parchment/90">Name</label>
          <input
            id="waitlist-name"
            name="name"
            type="text"
            required
            class="w-full rounded-md border border-parchment/20 bg-parchment/5 px-4 py-3 text-sm text-parchment placeholder:text-parchment/40 focus:border-brass focus:outline-none"
            placeholder="Jane Doe"
          />
        </div>
        <div>
          <label for="waitlist-email" class="mb-2 block text-sm font-semibold text-parchment/90">Email</label>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            required
            class="w-full rounded-md border border-parchment/20 bg-parchment/5 px-4 py-3 text-sm text-parchment placeholder:text-parchment/40 focus:border-brass focus:outline-none"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label for="waitlist-state" class="mb-2 block text-sm font-semibold text-parchment/90">State you're interested in</label>
          <input
            id="waitlist-state"
            name="state"
            type="text"
            class="w-full rounded-md border border-parchment/20 bg-parchment/5 px-4 py-3 text-sm text-parchment placeholder:text-parchment/40 focus:border-brass focus:outline-none"
            placeholder="California, Vermont, Virginia, Washington..."
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-sm bg-brass px-6 py-3.5 font-semibold text-navy transition hover:bg-brass-light"
        >
          Join the Waitlist →
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const role = data.get("role");
      const name = data.get("name");
      const email = data.get("email");
      const state = data.get("state") || "Not specified";
      const subject = encodeURIComponent(`Reading the Law waitlist — ${role}`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\nRole: ${role}\nState of interest: ${state}`
      );
      window.location.href = `mailto:hello@readingthelaw.org?subject=${subject}&body=${body}`;
    });
  </script>
</BaseLayout>
